        "#training\n",
        "BATCH_sIZE = 64\n",
        "trainset_loader = DataLoader(train_dataset,batch_size=BATCH_sIZE,shuffle=True)\n",
        "testset_loader = DataLoader(test_dataset,batch_size=BATCH_sIZE,shuffle=False)"
      ],
