        "def sampling(z_mean, z_logsigma):\n",
       
        "    eps = torch.randn_like(z_mean)\n",
        "\n",
       
        "    z = z_mean + torch.exp(z_logsigma) * eps\n",
       
        "\n",
        "    return z"
      ],
